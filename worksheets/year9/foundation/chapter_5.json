  "worksheets": [
    {
      "section_id": "9_5_1",
      "section_code": "5A",
      "title": "Solving Quadratic Equations via the Null Factor Law",
      "vcaa_code": "VC2M9A05",
      "tier": "Foundation",
      "estimated_minutes": 25,
      "fluency_questions": [
        {
          "number": 1,
          "prompt": "Use the Null Factor Law ($a \\times b = 0 \\implies a = 0$ or $b = 0$) to solve each equation:",
          "parts": [
            { "label": "a", "question": "$(x - 3)(x - 5) = 0$", "answer": "$x = 3$ or $x = 5$" },
            { "label": "b", "question": "$(x + 2)(x - 6) = 0$", "answer": "$x = -2$ or $x = 6$" },
            { "label": "c", "question": "$(x + 4)(x + 9) = 0$", "answer": "$x = -4$ or $x = -9$" },
            { "label": "d", "question": "$x(x - 7) = 0$", "answer": "$x = 0$ or $x = 7$" }
          ]
        },
        {
          "number": 2,
          "prompt": "Solve each two-factor equation:",
          "parts": [
            { "label": "a", "question": "$x(x + 8) = 0$", "answer": "$x = 0$ or $x = -8$" },
            { "label": "b", "question": "$(2x - 4)(x - 1) = 0$", "answer": "$x = 2$ or $x = 1$" },
            { "label": "c", "question": "$(x - 10)(x + 10) = 0$", "answer": "$x = 10$ or $x = -10$" },
            { "label": "d", "question": "$(x - 5)^2 = 0$", "answer": "$x = 5$" }
          ]
        },
        {
          "number": 3,
          "prompt": "Factorise out $x$ (or use difference of two squares) and solve:",
          "parts": [
            { "label": "a", "question": "$x^2 + 5x = 0$", "answer": "$x = 0$ or $x = -5$" },
            { "label": "b", "question": "$x^2 - 9x = 0$", "answer": "$x = 0$ or $x = 9$" },
            { "label": "c", "question": "$x^2 - 16 = 0$", "answer": "$x = 4$ or $x = -4$" },
            { "label": "d", "question": "$x^2 - 25 = 0$", "answer": "$x = 5$ or $x = -5$" }
          ]
        },
        {
          "number": 4,
          "prompt": "Factorise each trinomial and solve:",
          "parts": [
            { "label": "a", "question": "$x^2 + 5x + 6 = 0$", "answer": "$x = -2$ or $x = -3$" },
            { "label": "b", "question": "$x^2 + 7x + 10 = 0$", "answer": "$x = -2$ or $x = -5$" },
            { "label": "c", "question": "$x^2 - 6x + 8 = 0$", "answer": "$x = 2$ or $x = 4$" },
            { "label": "d", "question": "$x^2 - x - 6 = 0$", "answer": "$x = 3$ or $x = -2$" }
          ]
        }
      ],
      "application_questions": [
        {
          "number": 5,
          "question": "A square garden bed has side length $x\\text{ m}$ and an area of $36\\text{ m}^2$ ($x^2 - 36 = 0$). Solve for $x$ and state the valid side length.",
          "answer": "$x = 6\\text{ m}$ (since length cannot be negative)"
        },
        {
          "number": 6,
          "question": "A rectangular patio has area $x(x + 3) = 40\\text{ m}^2$. Check by substitution that $x = 5$ satisfies the equation, and state the patio's dimensions.",
          "answer": "$5 \\times (5 + 3) = 40$; width $5\\text{ m}$, length $8\\text{ m}$"
        },
        {
          "number": 7,
          "question": "A ball's height in metres is $h = t(4 - t)$. At what two times $t$ is the ball on the ground ($h = 0$)?",
          "answer": "$t = 0\\text{ s}$ and $t = 4\\text{ s}$"
        },
        {
          "number": 8,
          "question": "Two numbers multiply to $0$, and one of them is $x - 12$. What must the other factor be if $x \\neq 12$?",
          "answer": "The other factor must equal $0$"
        }
      ],
      "reasoning_questions": [
        {
          "number": 9,
          "question": "Why does $(x - 3)(x + 4) = 0$ give $x = 3$ and $x = -4$ instead of $x = -3$ and $x = 4$?",
          "answer": "We set each bracket equal to $0$: $x - 3 = 0$ gives $x = 3$, and $x + 4 = 0$ gives $x = -4$."
        },
        {
          "number": 10,
          "question": "In a measurement problem where $x$ represents the width of a room, why do we reject a negative solution like $x = -8$?",
          "answer": "Physical lengths and widths must be positive, so a negative value has no practical meaning."
        }
      ],
      "assertions": [
        { "id": "WSF9_5_1_1a", "expression": "(3 - 3)*(3 - 5)", "expected": 0 },
        { "id": "WSF9_5_1_2b", "expression": "(2*2 - 4)*(2 - 1)", "expected": 0 },
        { "id": "WSF9_5_1_3a", "expression": "(-5)**2 + 5*(-5)", "expected": 0 },
        { "id": "WSF9_5_1_3c", "expression": "4**2 - 16", "expected": 0 },
        { "id": "WSF9_5_1_4a", "expression": "(-2)**2 + 5*(-2) + 6", "expected": 0 },
        { "id": "WSF9_5_1_4c", "expression": "4**2 - 6*4 + 8", "expected": 0 },
        { "id": "WSF9_5_1_4d", "expression": "3**2 - 3 - 6", "expected": 0 },
        { "id": "WSF9_5_1_6", "expression": "5 * (5 + 3)", "expected": 40 }
      ]
    },
