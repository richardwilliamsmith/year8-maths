      "reasoning_questions": [
        {
          "number": 9,
          "question": "Why does $x^2 + 7x + 10$ factorise to $(x + 2)(x + 5)$ rather than $(x + 1)(x + 10)$?",
          "answer": "Although $1 \\times 10 = 10$ and $2 \\times 5 = 10$, we need the pair that adds to the middle coefficient $7$: $2 + 5 = 7$ (whereas $1 + 10 = 11$)."
