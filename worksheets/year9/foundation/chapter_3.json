        {
          "number": 7,
          "question": "A rectangular path has area $(5x + 20)\\text{ m}^2$ and width $5\\text{ m}$. Factorise $5x + 20$ to find its length.",
          "answer": "$5(x + 4)\\text{ m}^2$, so the length is $(x + 4)\\text{ m}$"
        },
        {
          "number": 8,
          "question": "First take out the common factor $2$ from $2x^2 - 18$, then factorise $x^2 - 9$ using difference of two squares.",
          "answer": "$2(x^2 - 9) = 2(x - 3)(x + 3)$"
        }
      ],
      "reasoning_questions": [
        {
          "number": 9,
          "question": "How can you check whether your factorisation $6x - 15 = 3(2x - 5)$ is correct?",
          "answer": "Expand the brackets $3(2x - 5) = 6x - 15$ to verify that it gives back the original expression."
        },
        {
          "number": 10,
          "question": "Why is $x^2 - 9$ called a 'difference of two squares'?",
          "answer": "Because it is the subtraction ('difference') of two square terms: $x^2$ and $3^2 = 9$."
        }
      ],
      "assertions": [
        { "id": "WSF9_3_2_1b", "expression": "expand(3*(2*x - 5) - (6*x - 15))", "expected": 0 },
        { "id": "WSF9_3_2_1d", "expression": "expand(3*x*(x - 3) - (3*x**2 - 9*x))", "expected": 0 },
        { "id": "WSF9_3_2_2a", "expression": "expand((x - 3)*(x + 3) - (x**2 - 9))", "expected": 0 },
        { "id": "WSF9_3_2_2d", "expression": "expand((x - 8)*(x + 8) - (x**2 - 64))", "expected": 0 },
        { "id": "WSF9_3_2_3a", "expression": "expand((x + 2)*(x + 5) - (x*(x + 2) + 5*(x + 2)))", "expected": 0 },
        { "id": "WSF9_3_2_4a", "expression": "expand((x + 2)*(x + 3) - (x**2 + 2*x + 3*x + 6))", "expected": 0 },
        { "id": "WSF9_3_2_5", "expression": "15**2 - 5**2", "expected": 200 },
        { "id": "WSF9_3_2_8", "expression": "expand(2*(x - 3)*(x + 3) - (2*x**2 - 18))", "expected": 0 }
      ]
    },
