            { "label": "c", "question": "$-5x < -20$", "answer": "$x > 4$" },
            { "label": "d", "question": "$10 - 2x \\ge 4$ ($\\implies -2x \\ge -6$)", "answer": "$x \\le 3$" }
          ]
        },
        {
          "number": 4,
          "prompt": "Substitute $(x, y) = (0, 0)$ to check whether the origin lies in the shaded half-plane:",
