        {
          "number": 1,
          "prompt": "Solve each one-step inequality for $x$:",
          "parts": [
            { "label": "a", "question": "$x + 5 > 12$", "answer": "$x > 7$" },
            { "label": "b", "question": "$x - 4 \\le 6$", "answer": "$x \\le 10$" },
            { "label": "c", "question": "$3x < 18$", "answer": "$x < 6$" },
