            { "label": "b", "question": "$2x + y > 4$", "answer": "No ($0 > 4$ is false)" },
            { "label": "c", "question": "$y \\le x + 3$", "answer": "Yes ($0 \\le 3$ is true)" },
            { "label": "d", "question": "$y \\ge 2x + 1$", "answer": "No ($0 \\ge 1$ is false)" }
